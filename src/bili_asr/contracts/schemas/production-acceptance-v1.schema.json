{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SuperCatQR/bilibili-asr-archive/docs/contracts/production-acceptance-v1.schema.json",
  "title": "Bili ASR production acceptance record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "record_id",
    "recorded_at",
    "environment",
    "operator_id",
    "release",
    "database_contract",
    "scope",
    "workers",
    "profile_digests",
    "checks",
    "operator_confirmed_production",
    "status"
  ],
  "properties": {
    "format": {
      "const": "bili-asr-production-acceptance"
    },
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "platform"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
        },
        "platform": {
          "enum": [
            "linux-x86_64",
            "linux-aarch64",
            "windows-amd64",
            "macos-arm64",
            "other"
          ]
        }
      }
    },
    "operator_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "build_id",
        "wheel_name",
        "wheel_sha256",
        "lock_sha256"
      ],
      "properties": {
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "build_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "wheel_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,254}\\.whl$"
        },
        "wheel_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "database_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_contract",
        "fingerprint"
      ],
      "properties": {
        "runtime_contract": {
          "enum": [
            "bilibili-v1",
            "universal-v2"
          ]
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_worker_roles",
        "worker_inventory_complete",
        "worker_inventory_evidence",
        "external_actor_inventory"
      ],
      "properties": {
        "expected_worker_roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "asr",
              "acquisition",
              "cpu",
              "editorial",
              "mixed"
            ]
          }
        },
        "worker_inventory_complete": {
          "type": "boolean"
        },
        "worker_inventory_evidence": {
          "$ref": "#/$defs/evidence"
        },
        "external_actor_inventory": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "status",
              "evidence"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "scheduler",
                  "backup_helper",
                  "worker_supervisor",
                  "gpu_runner",
                  "other"
                ]
              },
              "status": {
                "enum": [
                  "none",
                  "included",
                  "not_run"
                ]
              },
              "evidence": {
                "$ref": "#/$defs/evidence"
              }
            }
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "scheduler"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "backup_helper"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "worker_supervisor"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "gpu_runner"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "other"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        }
      }
    },
    "workers": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pid",
          "instance_id",
          "role",
          "phase",
          "heartbeat_at",
          "heartbeat_fresh",
          "build_id",
          "build_matches_release",
          "profile_digests"
        ],
        "properties": {
          "pid": {
            "type": "integer",
            "minimum": 1
          },
          "instance_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "role": {
            "enum": [
              "asr",
              "acquisition",
              "cpu",
              "editorial",
              "mixed"
            ]
          },
          "phase": {
            "enum": [
              "ready",
              "running",
              "draining"
            ]
          },
          "heartbeat_at": {
            "type": "string",
            "format": "date-time"
          },
          "heartbeat_fresh": {
            "type": "boolean"
          },
          "build_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "build_matches_release": {
            "type": "boolean"
          },
          "profile_digests": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "profile_digests": {
      "type": "array",
      "maxItems": 64000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "enum": [
              "source-delivered",
              "wheel-installed",
              "worker-loaded",
              "database-contract",
              "external-actor-scope",
              "offline-imports",
              "model-class-import",
              "gpu-short-pipeline",
              "gpu-long-sample",
              "drain-and-rollback"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_run"
            ]
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "not_run"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "evidence"
                ]
              }
            },
            "else": {
              "required": [
                "evidence"
              ]
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "source-delivered"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "wheel-installed"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "worker-loaded"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "database-contract"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "external-actor-scope"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "offline-imports"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "model-class-import"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "gpu-short-pipeline"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "gpu-long-sample"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "drain-and-rollback"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "operator_confirmed_production": {
      "type": "boolean"
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_delivered",
        "installed",
        "loaded",
        "production"
      ],
      "properties": {
        "source_delivered": {
          "enum": [
            "pending",
            "failed",
            "verified"
          ]
        },
        "installed": {
          "enum": [
            "pending",
            "failed",
            "verified"
          ]
        },
        "loaded": {
          "enum": [
            "pending",
            "failed",
            "verified"
          ]
        },
        "production": {
          "enum": [
            "pending",
            "failed",
            "production_verified"
          ]
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
